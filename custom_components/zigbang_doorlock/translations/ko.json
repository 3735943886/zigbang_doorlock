        },
        "sections": {
          "advanced": {
            "name": "고급",
            "description": "도어락을 다른 포트로 프로비저닝했거나 shadow 모드를 쓰려는 경우에만 바꾸세요.",
            "data": {
              "mqtts_port": "MQTTS 포트 (TCP)",
